rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ─────────────────────────────────────────────────────────
    // Supports both legacy { role: 'admin' } and new { roles: ['admin', 'official'] }

    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Returns true if the caller has the given role (works with both schemas)
    function callerHasRole(role) {
      let d = callerData();
      return (d.get('roles', []).hasAny([role]))
          || (d.get('role', '') == role);
    }

    function isAdmin() {
      return request.auth != null && callerHasRole('admin');
    }

    function isOfficial() {
      return request.auth != null && callerHasRole('official');
    }

    function isAdminOrOfficial() {
      return request.auth != null && (callerHasRole('admin') || callerHasRole('official'));
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Self-registration: officials register with status:'pending'
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.status == 'pending';

      // Users can read & update their own document
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Admins & officials can read any user document
      allow read: if isAdminOrOfficial();

      // Admins can approve/reject/ban/unban any user
      allow update: if isAdmin();

      // Officials can update users in their own barangay only
      allow update: if isOfficial()
                    && !isAdmin()
                    && callerData().get('barangay', '') == resource.data.barangay;

      // ── User notifications subcollection ──────────────────────────────────
      match /notifications/{notifId} {
        allow create: if isAdminOrOfficial();
        allow read, update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Reports ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {

      // Approved residents can create reports
      allow create: if request.auth != null
                    && callerData().status == 'approved'
                    && (callerData().get('roles', []).hasAny(['resident'])
                        || callerData().get('role', '') == 'resident');

      // Owners and admins/officials can read
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || isAdminOrOfficial());

      // Admins & officials can update / delete
      allow update, delete: if isAdminOrOfficial();

      // ── Status history subcollection ──────────────────────────────────────
      match /statusHistory/{histId} {
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid
                        || isAdminOrOfficial());
        allow create: if isAdminOrOfficial();
      }
    }

    // ── Admin notifications ───────────────────────────────────────────────
    match /admin_notifications/{notifId} {
      allow read, update: if isAdminOrOfficial();
      allow create: if request.auth != null;
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
